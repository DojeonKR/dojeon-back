        "title": "이에요/예요",
        "imageUrl": "",
        "explanations": [
          {
            "lang": "en",
            "text": "A noun marker used like \"Be\" Verb, to tell that a noun IS something."
          },
          {
            "lang": "he",
            "text": "סימון שם עצם שמשתמשים בו כאשר רוצים לתאר ששם העצם הוא משהו. ליודעי אנגלית, זה מקביל לפועל be (כלומר: am/is/are)"
          }
        ],
        "table": {
          "headers": ["받침", "형태", "예시"],
          "rows": [
            {
              "condition": "받침 O",
              "form": "N이에요",
              "examples": ["선생님이에요", "회사원이에요", "마이클이에요"]
            },
            {
              "condition": "받침 X",
              "form": "N예요",
              "examples": ["가수예요", "의사예요", "엠마예요"]
            }
          ]
        },
        "dialogues": [
          {
            "lines": [
              {
                "speaker": "가",
                "ko": "미국 사람이에요?",
