        "title": "아/어/해요",
        "imageUrl": "",
        "explanations": [
          {
            "lang": "he",
            "text": "זוהי צורת הווה פשוט. הצורה 아/어/해요 מתחברת לשורש של הפועל ולעיתים משנה את צורתו. היא משמשת להווה, להרגלים ולעיתים לעתיד קרוב, והיא צורה מנומסת המסתיימת ב־요."
          },
          {
            "lang": "en",
            "text": "This is the polite present-tense form. 아/어/해요 attaches to a verb stem and is used for present actions, habits, and sometimes the near future. Dictionary-form verbs end in 다."
          }
        ],
        "table": {
          "headers": ["규칙", "형태", "예시"],
          "rows": [
            { "condition": "어간의 마지막 모음이 ㅏ 또는 ㅗ", "form": "아요", "examples": ["가다 → 가요", "보다 → 봐요"] },
            { "condition": "그 밖의 모음", "form": "어요", "examples": ["먹다 → 먹어요", "읽다 → 읽어요", "쓰다 → 써요"] },
            { "condition": "하다", "form": "해요", "examples": ["공부하다 → 공부해요", "산책하다 → 산책해요"] }
          ]
        },
