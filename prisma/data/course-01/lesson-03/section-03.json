        "title": "을/를",
        "imageUrl": "",
        "explanations": [
          {
            "lang": "he",
            "text": "סיומת יחס שמחברת שם עצם לפועל ומסמנת את מושא הפעולה. שימו לב: 무엇 מתקצר ל־뭐, ו־무엇을 מתקצר ל־뭘."
          },
          {
            "lang": "en",
            "text": "을/를 is an object particle that connects a noun to the verb. Use 을 after a final consonant and 를 after a final vowel. 무엇 can be shortened to 뭐, and 무엇을 to 뭘."
          }
        ],
        "table": {
          "headers": ["받침", "형태", "예시"],
          "rows": [
            { "condition": "받침 O", "form": "N을", "examples": ["밥을 먹어요", "물을 마셔요", "책을 읽어요"] },
            { "condition": "받침 X", "form": "N를", "examples": ["영화를 봐요", "바나나를 사요", "편지를 써요"] }
          ]
        },
        "dialogues": [
          {
            "lines": [
              { "speaker": "가", "ko": "나나코 씨, 무엇을 해요?", "en": "Nanako-ssi, what are you doing?", "he": "נאנאקו-שי, מה את עושה?" },
              { "speaker": "나", "ko": "저는 밥을 먹어요.", "en": "I'm eating a meal.", "he": "אני אוכלת אוכל." }
