        "title": "이/가",
        "imageUrl": "",
        "explanations": [
          {
            "lang": "he",
            "text": "סימון עצם שמסמן נושא משפט."
          },
          {
            "lang": "en",
            "text": "It is used to mark a noun as the sentence's subject."
          }
        ],
        "table": {
          "headers": ["받침", "형태", "예시"],
          "rows": [
            { "condition": "받침 O", "form": "N이", "examples": ["볼펜이", "문이", "책상이"] },
            { "condition": "받침 X", "form": "N가", "examples": ["컴퓨터가", "지갑가", "의자가", "창문가"] }
          ]
        },
        "irregulars": {
          "title": "불규칙",
          "titleHe": "יוצאי דופן",
          "titleEn": "Exceptions",
          "rows": [
            { "from": "누구 + 가", "to": "누가" },
            { "from": "저 + 가", "to": "제가" },
            { "from": "나 + 가", "to": "내가" },
            { "from": "너 + 가", "to": "네가" }
          ]
        },
        "extraNotes": [
          {
            "lang": "he",
            "text": "הצורה הזו (이/가) דומה מאוד ל־은/는 שלמדנו בשיעור הקודם. משתמשים ב־이/가 בעיקר עם פעלים ותארים. 이것이 책이에요 = 이것은 책이에요."
          },
          {
            "lang": "en",
            "text": "This form (이/가) is very similar to 은/는 from the previous lesson. We often use 이/가 with verbs and adjectives. 이것이 책이에요 = 이것은 책이에요."
          }
        ],
