        "title": "이 그 저",
        "imageUrl": "",
        "explanations": [
          {
            "lang": "he",
            "text": "המילה 것 משמעותה \"דבר\". אנו נשתמש במילים אלו על מנת להגיד \"זה\". המילה שנשתמש בה תשתנה לפי מיקום החפץ. א. 이것 - קרוב לדובר. ב. 그것 - קרוב לשומע. ג. 저것 - רחוק משניהם."
          },
          {
            "lang": "en",
            "text": "The word 것 means \"thing.\" We use the following words to say \"this\" or \"that.\" a. 이것 – close to the speaker. b. 그것 – close to the listener. c. 저것 – far from both."
          }
        ],
        "table": {
          "headers": ["형태", "의미", "위치"],
          "rows": [
            { "condition": "이것", "form": "this", "examples": ["이것은 책이에요"] },
            { "condition": "그것", "form": "that", "examples": ["그것은 시계예요"] },
            { "condition": "저것", "form": "that (over there)", "examples": ["저것은 의자예요"] }
          ]
        },
        "dialogues": [
          {
            "lines": [
              { "speaker": "가", "ko": "이것은 뭐예요?", "en": "What is this?", "he": "מה זה?" },
