# Prisma Studio — EC2 Postgres (SSH 터널 필수)
# 1) 이 파일을 복사:  cp .env.studio.example .env.studio   (Windows: copy .env.studio.example .env.studio)
# 2) POSTGRES_PASSWORD 를 EC2 ~/dojeon-back/.env 와 동일하게 맞춤
# 3) 다른 터미널에서 SSH 터널 실행 (docs/PRISMA-STUDIO.md 참고)
# 4) npm run studio:remote

DATABASE_URL=postgresql://dojeon:POSTGRES_PASSWORD_HERE@127.0.0.1:5433/dojeon?schema=public
